# MTC SmartBus Environment Configuration

# Server & Feed Settings
PORT=3000
LOG_LEVEL=info
SMARTBUS_FEED_MODE=demo
SMARTBUS_FEED_TIMEOUT_MS=8000

# Optional MTC Live Provider Credentials (falls back to simulated demo data)
MTC_CAMERA_FEED_URL=
MTC_CAMERA_FEED_TOKEN=
MTC_ETM_FEED_URL=
MTC_ETM_FEED_TOKEN=
MTC_PROVIDER_TOKEN=

# BusMaps Public Transit API Configuration
BUSMAPS_API_KEY=
BUSMAPS_API_HOST=busmaps.com

# Database URL (optional, in-memory mock used if not set)
DATABASE_URL=

# Gemini API Key (server-side only)
GEMINI_API_KEY=
